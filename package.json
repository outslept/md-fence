{
  "name": "md-fence",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "zshy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest --reporter=dot",
    "test:cov": "vitest run --coverage --reporter=dot",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run lint && pnpm run test && pnpm run build"
  },
  "zshy": "src/index.ts",
  "packageManager": "pnpm@10.15.0",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "4.0.1",
    "eslint": "^9.38.0",
    "neostandard": "^0.12.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.1",
    "zshy": "^0.4.4"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  }
}
